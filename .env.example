# Environment Configuration for Lucifer

# App Environment (development | staging | production)
LUCIFER_ENV=development
DEFAULT_TIMEZONE=Asia/Kolkata
BUDGET_MODE=FREE_ONLY

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# AI Provider API Keys (Supports comma-separated keys for load balancing)
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=

# Local Ollama Settings
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=gemma2:2b

# Integrations
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lucifer.your-worker.workers.dev/oauth/google/callback

# Device Security
DEVICE_ENCRYPTION_KEY=
